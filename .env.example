# Seamless Tile API — environment configuration.
# Copy to `.env` and adjust. Keys are optional; unset keys fall back to the defaults
# in app/core/config.py (pydantic-settings, names are case-insensitive).

# --- App ---
APP_NAME=essesion-seamless-tile
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Raster export (Phase 2) ---
# Path to the resvg / rsvg-convert binary. Unset => auto-detect on PATH.
# RENDERER_BIN=/opt/homebrew/bin/resvg
MAX_DPI=1200
MAX_TILE_MM=2000.0

# --- Supabase motif persistence (session 9) ---
# Direct Postgres DSN for the motif store (psycopg). Unset/empty => in-memory registry
# only (no persistence; the app still runs and lazy-loads nothing). Use the direct
# connection URI or the pooler URI (:6543). Keep this SERVER-SIDE ONLY — a direct
# connection bypasses PostgREST row-level security.
# SUPABASE_DB_URL=postgresql://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Reserved for future REST/Storage use (S11+); unused in P0.
# SUPABASE_SERVICE_KEY=
