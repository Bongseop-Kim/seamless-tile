# Seamless Tile API — environment configuration.
# Copy to `.env` and adjust. Keys are optional; unset keys fall back to the defaults
# in app/core/config.py (pydantic-settings, names are case-insensitive).

# --- App ---
APP_NAME=essesion-seamless-tile
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Raster export (Phase 2) ---
# Path to the resvg / rsvg-convert binary. Unset => auto-detect on PATH.
# RENDERER_BIN=/opt/homebrew/bin/resvg
MAX_DPI=1200
MAX_TILE_MM=2000.0

# --- Supabase motif persistence (session 9) ---
# Postgres DSN for the motif store (psycopg) AND the /generate operation logs
# (seamless_generation_logs). Unset/empty => in-memory registry only and logging is a
# no-op (the app + full test suite still run green). Keep SERVER-SIDE ONLY — bypasses RLS.
#
# Use the SESSION POOLER (IPv4, port 5432), NOT the direct host: db.<project-ref>.supabase.co
# is IPv6-only and unreachable from IPv4-only hosts (most CI / many cloud runners). The
# pooler user MUST be postgres.<project-ref>. Copy the exact string from Supabase
# Dashboard → Project Settings → Database → Connection string (Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Candidate preview PNG → Supabase Storage (generate route) ---
# When SUPABASE_URL + SUPABASE_SERVICE_KEY are BOTH set, /generate renders each candidate
# SVG to a preview PNG and uploads it to the PREVIEW_BUCKET; the response returns the
# public URL as candidates[].png_url. Unset => png_url is null + a warning (graceful).
# Requires an SVG renderer on PATH (resvg / rsvg-convert; `brew install librsvg`).
#
# Project REST/Storage base URL (Dashboard → Project Settings → API → Project URL).
# SUPABASE_URL=https://<project-ref>.supabase.co
# service_role key (Dashboard → Project Settings → API → service_role). SERVER-SIDE ONLY
# — full RLS bypass, NEVER expose to clients.
# SUPABASE_SERVICE_KEY=<your-service-role-key>
# Storage bucket for preview PNGs (default: seamless-previews; owned by the YeongSeon monorepo).
# PREVIEW_BUCKET=seamless-previews
# Preview raster resolution in DPI for one tile (default: 96).
# PREVIEW_DPI=96

# --- Chat LLM (session 10) ---
# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey). When set,
# app.main installs a GeminiClient as the default LLM client at boot; unset => the
# prompt path needs a per-call injected client (tests inject fakes).
# GEMINI_API_KEY=<your-gemini-api-key>
# Optional chat model id (default: gemini-2.5-flash-lite).
# GEMINI_MODEL=gemini-2.5-flash-lite

# --- Embedding model (session 11, D12) ---
# OpenAI API key (https://platform.openai.com/api-keys). When set, app.main installs an
# OpenAIEmbeddingClient as the default; unset => the motif resolver skips the soft-
# similarity (τ) stage and falls back to exact/hard-filter reuse (graceful). SERVER-SIDE ONLY.
# OPENAI_API_KEY=<your-openai-api-key>
# Optional overrides (defaults shown):
# EMBEDDING_MODEL=text-embedding-3-small
# MOTIF_SIMILARITY_TAU=0.60

# --- Recraft vector generation (session 13, D11/M1) ---
# Recraft API token (https://www.recraft.ai/ → API). When set, app.main installs a
# RecraftHTTPClient as the default Recraft client; unset => detailed/multicolor motif
# misses surface a 502 (the LLM still handles simple motifs). SERVER-SIDE ONLY.
# RECRAFT_API_KEY=<your-recraft-api-token>
# Vector model id (a *_vector model). Options: recraftv4_1_vector (default, "V4.1 Vector"),
# recraftv4_vector, recraftv3_vector (+ *_pro_vector). The model drives SVG output.
# RECRAFT_MODEL=recraftv4_1_vector
# Style is OPTIONAL for vector models (omitted by default). Set only to force a substyle.
# RECRAFT_STYLE=
# RECRAFT_SIZE=1024x1024
# How the SVG comes back: `url` (default; a second GET fetches the .svg file) or
# `b64_json` (SVG returned base64-inline in the same response).
# RECRAFT_RESPONSE_FORMAT=url
# RECRAFT_BASE_URL=https://external.api.recraft.ai/v1
# Max color slots a Recraft motif may keep; excess colors are deterministically merged.
# RECRAFT_MAX_COLOR_SLOTS=6
