# Seamless Tile API — environment configuration.
# Copy to `.env` and adjust. Keys are optional; unset keys fall back to the defaults
# in app/core/config.py (pydantic-settings, names are case-insensitive).

# --- App ---
APP_NAME=essesion-seamless-tile
DEBUG=false
API_V1_PREFIX=/api/v1

# --- Raster export (Phase 2) ---
# Path to the resvg / rsvg-convert binary. Unset => auto-detect on PATH.
# RENDERER_BIN=/opt/homebrew/bin/resvg
MAX_DPI=1200
MAX_TILE_MM=2000.0

# --- Supabase motif persistence (session 9) ---
# Postgres DSN for the motif store (psycopg). Unset/empty => in-memory registry only
# (the app + full test suite still run green). Keep SERVER-SIDE ONLY — bypasses RLS.
#
# Use the SESSION POOLER (IPv4, port 5432), NOT the direct host: db.<project-ref>.supabase.co
# is IPv6-only and unreachable from IPv4-only hosts (most CI / many cloud runners). The
# pooler user MUST be postgres.<project-ref>. Copy the exact string from Supabase
# Dashboard → Project Settings → Database → Connection string (Session pooler).
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<DB_PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Reserved for future REST/Storage use (S11+); unused in P0.
# SUPABASE_SERVICE_KEY=

# --- Chat LLM (session 10) ---
# Gemini API key (Google AI Studio: https://aistudio.google.com/apikey). When set,
# app.main installs a GeminiClient as the default LLM client at boot; unset => the
# prompt path needs a per-call injected client (tests inject fakes).
# GEMINI_API_KEY=<your-gemini-api-key>
# Optional chat model id (default: gemini-2.5-flash-lite).
# GEMINI_MODEL=gemini-2.5-flash-lite
